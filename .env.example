# Supabase - Project Settings > API
# Copiar a .env.local y completar con los valores de tu proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor: permite crear usuarios desde la app (Supabase > Project
# Settings > API > service_role key). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
